# ---------------------------------------------------------------------------
# REU Experience Day — environment variables
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). Leave all four empty locally to use the
# built-in embedded database instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix!).
SUPABASE_SERVICE_ROLE_KEY=

# Public copies used by the browser for Realtime seat-count updates.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin dashboard login (required in production). Locally defaults to 2026.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=
